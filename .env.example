# ── Скопируй в .env и заполни. .env в .gitignore, в публичный репо НЕ коммитить. ──

# Postgres (локально — контейнер postgres16, отдельная БД под проект)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sbavito

# Redis (память диалога, очереди/дебаунс, кеш прайса)
REDIS_URL=redis://localhost:6379/3

# Логи
LOG_LEVEL=info

# OpenRouter (ИИ-ядро) — ключ брать из доступов, сюда НЕ вписывать реальное значение
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Telegram (песочница для обкатки)
TELEGRAM_BOT_TOKEN=

# amoCRM Chat API (этап 8) — секреты только в .env/GitHub Secrets
AMOJO_ID=0cbc3c68-7c8a-4ffe-962b-d6b081f166bc
AMO_CHAT_CHANNEL_ID=
AMO_CHAT_CHANNEL_SECRET=
