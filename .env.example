# ── Скопируй в .env и заполни. .env в .gitignore, в публичный репо НЕ коммитить. ──

# Postgres. Локально — существующий контейнер postgres16 (:5432): свой не поднимаем,
# образ общий с соседними проектами. Своя БД sbavito и своя схема sbavito.
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=sbavito
PGSCHEMA=sbavito

# Redis — существующий контейнер redis (:6379). Память диалога, дебаунс, round-robin.
REDIS_URL=redis://127.0.0.1:6379/3

# Логи: info | debug (debug добавляет в лог промпт и ответ модели)
LOG_LEVEL=info

# OpenRouter (ИИ-ядро, этап 8) — ключ брать из доступов, сюда НЕ вписывать
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
# Молчать при сбое ИИ: on (дефолт) — на ошибку модели / кончившийся баланс
# OpenRouter бот НЕ шлёт клиенту заглушку «подвисло», а молчит (менеджер видит чат
# в amoCRM). off — вернуть старую заглушку-фолбэк.
AI_TIHIY_PRI_SBOE=on

# Telegram-боты обкатки (этап 10) — по одному на аккаунт Авито.
# Пустой токен = бот не поднимается, остальные работают.
TG_TOKEN_SAUNAMART=
TG_TOKEN_SBSAUNA=
TG_TOKEN_DESHMAN=

# Живой каталог из Google-таблицы (этап 16). Пустой GOOGLE_CREDS_PUT = синк
# ВЫКЛЮЧЕН: бот работает из БД/файла, как раньше. Ключ сервисного аккаунта
# лежит вне git — сюда пишем только ПУТЬ к нему, не содержимое.
# id таблицы и лист по умолчанию зашиты в bot/etl/google_prays.py; переопредели
# переменными ниже только если нужен другой источник.
GOOGLE_CREDS_PUT=
GOOGLE_TABLICA_ID=
GOOGLE_LIST=
GOOGLE_SYNC_INTERVAL_S=600
# Два НЕЗАВИСИМЫХ выключателя (обоим нужен GOOGLE_CREDS_PUT):
# GOOGLE_KATALOG — синк каталога товаров Saunamart (вкладка «Saunamart»). По
#   умолчанию on: заданный ключ включает синк каталога, как раньше.
# GOOGLE_ZNANIYA — синк базы знаний услуг = промпты (вкладки «SB SAUNA»,
#   «SB SAUNA Дешман»). По умолчанию off: включается отдельно, чтобы правку
#   промптов можно было запустить, не активируя переход каталога на Google.
GOOGLE_KATALOG=on
GOOGLE_ZNANIYA=off
# GOOGLE_RUBILNIK — синк листа-пульта «Рубильник»: заказчик глушит/включает ОТВЕТЫ
#   бота по каждому аккаунту прямо из Google-таблицы (зеркало входящих в amoCRM при
#   этом работает). По умолчанию on (нужен GOOGLE_CREDS_PUT). Нет вкладки → все боты
#   отвечают (no-op). Имя вкладки — GOOGLE_LIST_RUBILNIK (по умолчанию «Рубильник»).
GOOGLE_RUBILNIK=on
GOOGLE_LIST_RUBILNIK=Рубильник

# Avito Messenger API (этап 14) — по одному приложению на аккаунт, суффикс = код
# аккаунта в ВЕРХНЕМ регистре (SAUNAMART | SBSAUNA | DESHMAN). Незаполненный
# CLIENT_ID/SECRET = поллер аккаунта не поднимается. Grant client_credentials,
# redirect_uri не используется. Секреты — только в .env / GitHub Secrets.
AVITO_CLIENT_ID_SBSAUNA=
AVITO_CLIENT_SECRET_SBSAUNA=
AVITO_USER_ID_SBSAUNA=
AVITO_CLIENT_ID_SAUNAMART=
AVITO_CLIENT_SECRET_SAUNAMART=
AVITO_USER_ID_SAUNAMART=
AVITO_CLIENT_ID_DESHMAN=
AVITO_CLIENT_SECRET_DESHMAN=
AVITO_USER_ID_DESHMAN=

# amoCRM Chat API (этап 14) — секреты только в .env / GitHub Secrets
AMOJO_ID=
AMO_CHAT_CHANNEL_ID=
AMO_CHAT_CHANNEL_SECRET=
# Зеркало диалога Авито → amoCRM (14.3): off | on
AMO_ZERKALO=off
# amojo_id пользователя amoCRM для показа реплик бота как ИСХОДЯЩИХ в карточке
# (14.9-C). ⚠️ Именно amojo_id из `GET /api/v4/users?with=amojo_id`, НЕ обычный uuid
# (на uuid amojo отвечает «sender: user not found»). Пусто → зеркалим только
# входящие клиента. Глобальный фолбэк; per-account перекрывается ниже.
AMO_BOT_REF_ID=
# Реплики бота от имени менеджера аккаунта (перекрывают глобальный AMO_BOT_REF_ID):
AMO_BOT_REF_ID_SAUNAMART=
AMO_BOT_REF_ID_SBSAUNA=
AMO_BOT_REF_ID_DESHMAN=
# amoCRM REST API v4 (14.4): долгосрочный токен интеграции. Полный доступ к CRM —
# только в .env / GitHub Secrets.
AMO_BASE=https://ВАШ_СУБДОМЕН.amocrm.ru
AMO_ACCESS_TOKEN=

# HTTP-API панели-виджета (этап 14.7, кирпич 2): отдаёт ленту диалога из Postgres
# виджету amoCRM. Пустой PANEL_API_TOKEN = API НЕ поднимается. Токен — секрет,
# только в .env / GitHub Secrets; nginx проксирует https://bot-admin.online/api → :порт.
# PANEL_CORS_ORIGIN — домен виджета для CORS (https://ВАШ_СУБДОМЕН.amocrm.ru); * = любой.
PANEL_API_TOKEN=
PANEL_API_PORT=8080
PANEL_CORS_ORIGIN=*
